#!name=Spotify 自持（固定地址版）
#!desc=地址永不更换。开关全在脚本里，改脚本不用换 URL：
#!desc=· spotify-ucs-min.js 顶部 CONFIG：INJECT(false=纯拦截) / SHOW_NAME(显示 Spotify Premium，用于确认注入是否生效)
#!desc=· probe-browse.js 默认关闭；改成返回空响应可验证远程脚本是否在执行
#!author=local
#!category=Spotify

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT
DOMAIN,aet.spotify.com,REJECT

[URL Rewrite]
# 广告服务端点（从 liborbit-jni-spotify.so 里挖出的真实路径）
^https:\/\/(spclient\.wg|[A-Za-z0-9-]+-spclient)\.spotify\.com(?::443)?\/ads\/v3\/ads - reject
^https:\/\/(spclient\.wg|[A-Za-z0-9-]+-spclient)\.spotify\.com(?::443)?\/ads\/v[23]\/config - reject
^https:\/\/(spclient\.wg|[A-Za-z0-9-]+-spclient)\.spotify\.com(?::443)?\/ad-logic\/v3\/config - reject
^https:\/\/(spclient\.wg|[A-Za-z0-9-]+-spclient)\.spotify\.com(?::443)?\/ad-logic\/prefetch - reject
^https:\/\/(spclient\.wg|[A-Za-z0-9-]+-spclient)\.spotify\.com(?::443)?\/ad-logic\/state\/config - reject
# 展示层
^https:\/\/(spclient\.wg|[A-Za-z0-9-]+-spclient)\.spotify\.com(?::443)?\/pendragon - reject
^https:\/\/[A-Za-z0-9-]+-spclient\.spotify\.com(?::443)?\/pam-view-service\/ - reject

[Script]
# 请求层删 If-None-Match（替代 [Header Rewrite]，后者在 Shadowrocket 上支持不确定）
etagStrip = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com(?::443)?)\/user-customization-service\/v1\/customize$,script-path=https://raw.githubusercontent.com/wongzeonsing/iptv/main/spotify/strip-etag.js,script-update-interval=0
# 响应类探针（打在歌手页 JSON 上，正常时无副作用由脚本自身决定）
probeArtist = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com(?::443)?)\/artistview\/v1\/artist,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/wongzeonsing/iptv/main/spotify/probe-artist.js,script-update-interval=0
# 请求类探针（URL 改写）
probeBrowse = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com(?::443)?)\/browsita\/v.\/browse,script-path=https://raw.githubusercontent.com/wongzeonsing/iptv/main/spotify/probe-browse.js,script-update-interval=0
# 属性注入（CONFIG 控制）
proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com(?::443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/wongzeonsing/iptv/main/spotify/spotify-ucs-min.js,script-update-interval=0
# 广告上报通道：回空 200
gabo = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com(?::443)?)\/gabo-receiver-service,requires-body=0,script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/spot-gabo.js
# 首页滚动区广告卡片过滤
noScrollAd = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com(?::443)?)\/scrollsita\/v.\/scroll\/spotify,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/spot-NoScrollAd.js

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com
